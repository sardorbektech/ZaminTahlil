# Ish rejimi: demo yoki prod
APP_ENV=demo

SENTINEL_HUB_CLIENT_ID=sh-..........
SENTINEL_HUB_CLIENT_SECRET=xO2..........
OPENAI_API_KEY=sk-.........
DATABASE_PATH=./data/zamintahlil.sqlite3
ARTIFACT_DIR=./data/artifacts
CLOUD_FREE_THRESHOLD=20
SENTINEL_TIMEOUT_SECONDS=45
OPENAI_TIMEOUT_SECONDS=45
OPENAI_PRIMARY_MODEL=gpt-5.4-nano
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
# Ruxsat etilgan frontend domenlari (vergul bilan). Hozircha bo'sh — demo rejimda
# barcha originlarga ruxsat beriladi. Prodga o'tganda haqiqiy domenlarni yozing.
# Masalan: CORS_ORIGINS=https://mening-saytim.uz,https://www.mening-saytim.uz
CORS_ORIGINS=

# Agar identity.dataspace.copernicus.eu bloklangan bo'lsa, HTTP proksi manzili (ixtiyoriy)
# Masalan: SENTINEL_PROXY=http://127.0.0.1:8080
SENTINEL_PROXY=
